<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ps_bg_dark">

    <!-- TOP TOOLBAR -->
    <LinearLayout
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/ps_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/ps_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- UNDO BUTTON -->
        <ImageButton
            android:id="@+id/btn_undo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="@string/action_undo"
            app:tint="@color/ps_text_secondary" />

        <!-- REDO BUTTON -->
        <ImageButton
            android:id="@+id/btn_redo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:rotationY="180"
            android:contentDescription="@string/action_redo"
            app:tint="@color/ps_text_secondary" />

        <!-- SAVE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/ps_accent"
            android:text="@string/action_save"
            android:textColor="@color/ps_text_primary"
            android:textSize="13sp"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <!-- PHOTO CANVAS -->
    <FrameLayout
        android:id="@+id/canvas_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_toolbar"
        app:layout_constraintBottom_toTopOf="@id/sub_tool_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.mynxx.photoshop.ui.PhotoEditorView
            android:id="@+id/photo_editor_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- EMPTY STATE VIEW -->
        <LinearLayout
            android:id="@+id/empty_state_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/ps_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/empty_canvas_hint"
                android:textAlignment="center"
                android:textColor="@color/ps_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- SUB-TOOL CONTROL PANEL (Colors, Sliders, Filters) -->
    <FrameLayout
        android:id="@+id/sub_tool_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ps_surface_elevated"
        android:padding="8dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottom_toolbar">

        <!-- BRUSH CONTROLS -->
        <LinearLayout
            android:id="@+id/panel_brush"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/color_palette_container"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tamanho:"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_brush_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="80"
                    android:progress="16" />
            </LinearLayout>
        </LinearLayout>

        <!-- FILTERS HORIZONTAL SCROLL -->
        <HorizontalScrollView
            android:id="@+id/panel_filters"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/filter_buttons_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ADJUSTMENTS SLIDERS (Brightness, Contrast, Saturation) -->
        <LinearLayout
            android:id="@+id/panel_adjustments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Brightness -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_brightness"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="12sp" />
                <SeekBar
                    android:id="@+id/seek_brightness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
            </LinearLayout>

            <!-- Contrast -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_contrast"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="12sp" />
                <SeekBar
                    android:id="@+id/seek_contrast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
            </LinearLayout>

            <!-- Saturation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_saturation"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="12sp" />
                <SeekBar
                    android:id="@+id/seek_saturation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- BOTTOM TOOLBAR (Scrollable Photoshop Tools) -->
    <HorizontalScrollView
        android:id="@+id/bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/ps_surface"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <!-- CAMERA -->
            <LinearLayout
                android:id="@+id/tool_btn_camera"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@color/ps_text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tool_camera"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- GALLERY -->
            <LinearLayout
                android:id="@+id/tool_btn_gallery"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/ps_text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tool_gallery"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- BRUSH -->
            <LinearLayout
                android:id="@+id/tool_btn_brush"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/ps_text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tool_brush"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- ERASER -->
            <LinearLayout
                android:id="@+id/tool_btn_eraser"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="@color/ps_text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tool_eraser"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- FILTERS -->
            <LinearLayout
                android:id="@+id/tool_btn_filters"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_slideshow"
                    app:tint="@color/ps_text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tool_filters"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- ADJUSTMENTS -->
            <LinearLayout
                android:id="@+id/tool_btn_adjust"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="@color/ps_text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tool_adjust"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- ROTATE -->
            <LinearLayout
                android:id="@+id/tool_btn_rotate"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    app:tint="@color/ps_text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tool_rotate"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- TEXT -->
            <LinearLayout
                android:id="@+id/tool_btn_text"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_add"
                    app:tint="@color/ps_text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tool_text"
                    android:textColor="@color/ps_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
